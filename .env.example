# Copy to .env.local and replace these examples with values from your Agent tenant.
# NEXT_PUBLIC_ values are visible in the browser. Never put a secret in them.
NEXT_PUBLIC_AGENT_API_URL=https://neuron.example.invalid
NEXT_PUBLIC_AGENT_API_URI=neuron.example.invalid

# Server-only credentials used by POST /api/agent/account/create.
AGENT_API_KEY=replace-with-non-production-key
AGENT_SECRET=replace-with-non-production-secret

# Optional: set if server routes should use a different Agent URL.
# AGENT_API_URL=https://neuron.example.invalid

# Optional: display partner context on the entry page.
# NEXT_PUBLIC_ACCESS_PARTNER=Example Partner
